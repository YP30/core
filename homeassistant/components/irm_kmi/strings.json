{
  "common": {
    "language_override_description": "Override the Home Assistant language for forecast texts and the radar hint."
  },
  "config": {
    "abort": {
      "already_configured": "[%key:common::config_flow::abort::already_configured_location%]",
      "reconfigure_successful": "[%key:common::config_flow::abort::reconfigure_successful%]"
    },
    "error": {
      "cannot_connect": "[%key:common::config_flow::error::cannot_connect%]",
      "out_of_benelux": "The location is outside of Benelux. Pick a location in Benelux."
    },
    "step": {
      "reconfigure": {
        "data": {
          "location": "[%key:common::config_flow::data::location%]"
        },
        "data_description": {
          "location": "[%key:component::irm_kmi::config::step::user::data_description::location%]"
        }
      },
      "user": {
        "data": {
          "location": "[%key:common::config_flow::data::location%]"
        },
        "data_description": {
          "location": "The location to get weather data for. It must be in Belgium, Luxembourg or the Netherlands."
        }
      }
    }
  },
  "entity": {
    "image": {
      "radar": {
        "name": "Radar",
        "state_attributes": {
          "hint": {
            "name": "Hint"
          }
        }
      }
    }
  },
  "exceptions": {
    "api_error": {
      "message": "An error occurred while communicating with the API: {error}"
    },
    "radar_unavailable": {
      "message": "The rain radar image could not be downloaded."
    }
  },
  "options": {
    "step": {
      "init": {
        "data": {
          "dark_mode": "Dark mode radar",
          "language_override": "[%key:common::config_flow::data::language%]",
          "radar_style": "Radar style"
        },
        "data_description": {
          "dark_mode": "Draw the radar on a dark background. The Dutch radar is only available on a light background.",
          "language_override": "[%key:component::irm_kmi::common::language_override_description%]",
          "radar_style": "Colors of the rain radar."
        },
        "title": "Options"
      }
    }
  },
  "selector": {
    "language_override": {
      "options": {
        "de": "German",
        "en": "English",
        "fr": "French",
        "nl": "Dutch",
        "none": "Follow Home Assistant server language"
      }
    },
    "radar_style": {
      "options": {
        "contrast_style": "High contrast",
        "satellite_style": "Satellite",
        "standard_style": "Standard",
        "yellow_red_style": "Yellow and red"
      }
    }
  },
  "title": "Royal Meteorological Institute of Belgium"
}
