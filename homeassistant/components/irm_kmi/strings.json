{
  "common": {
    "language_override_description": "Override the Home Assistant language for forecast texts and warnings."
  },
  "config": {
    "abort": {
      "already_configured": "[%key:common::config_flow::abort::already_configured_location%]",
      "api_error": "[%key:common::config_flow::error::cannot_connect%]"
    },
    "error": {
      "out_of_benelux": "The location is outside of Benelux. Pick a location in Benelux."
    },
    "step": {
      "user": {
        "data": {
          "location": "[%key:common::config_flow::data::location%]"
        },
        "data_description": {
          "location": "[%key:common::config_flow::data::location%]"
        }
      }
    }
  },
  "entity": {
    "binary_sensor": {
      "warning": {
        "name": "Warning",
        "state_attributes": {
          "warnings": {
            "name": "Warnings"
          }
        }
      }
    },
    "sensor": {
      "next_warning": {
        "name": "Next warning"
      },
      "pollen_alder": {
        "name": "Alder pollen",
        "state": {
          "active": "[%key:common::state::active%]",
          "green": "Green",
          "none": "None",
          "orange": "Orange",
          "purple": "Purple",
          "red": "Red",
          "yellow": "Yellow"
        }
      },
      "pollen_ash": {
        "name": "Ash pollen",
        "state": {
          "active": "[%key:common::state::active%]",
          "green": "[%key:component::irm_kmi::entity::sensor::pollen_alder::state::green%]",
          "none": "[%key:component::irm_kmi::entity::sensor::pollen_alder::state::none%]",
          "orange": "[%key:component::irm_kmi::entity::sensor::pollen_alder::state::orange%]",
          "purple": "[%key:component::irm_kmi::entity::sensor::pollen_alder::state::purple%]",
          "red": "[%key:component::irm_kmi::entity::sensor::pollen_alder::state::red%]",
          "yellow": "[%key:component::irm_kmi::entity::sensor::pollen_alder::state::yellow%]"
        }
      },
      "pollen_birch": {
        "name": "Birch pollen",
        "state": {
          "active": "[%key:common::state::active%]",
          "green": "[%key:component::irm_kmi::entity::sensor::pollen_alder::state::green%]",
          "none": "[%key:component::irm_kmi::entity::sensor::pollen_alder::state::none%]",
          "orange": "[%key:component::irm_kmi::entity::sensor::pollen_alder::state::orange%]",
          "purple": "[%key:component::irm_kmi::entity::sensor::pollen_alder::state::purple%]",
          "red": "[%key:component::irm_kmi::entity::sensor::pollen_alder::state::red%]",
          "yellow": "[%key:component::irm_kmi::entity::sensor::pollen_alder::state::yellow%]"
        }
      },
      "pollen_grasses": {
        "name": "Grass pollen",
        "state": {
          "active": "[%key:common::state::active%]",
          "green": "[%key:component::irm_kmi::entity::sensor::pollen_alder::state::green%]",
          "none": "[%key:component::irm_kmi::entity::sensor::pollen_alder::state::none%]",
          "orange": "[%key:component::irm_kmi::entity::sensor::pollen_alder::state::orange%]",
          "purple": "[%key:component::irm_kmi::entity::sensor::pollen_alder::state::purple%]",
          "red": "[%key:component::irm_kmi::entity::sensor::pollen_alder::state::red%]",
          "yellow": "[%key:component::irm_kmi::entity::sensor::pollen_alder::state::yellow%]"
        }
      },
      "pollen_hazel": {
        "name": "Hazel pollen",
        "state": {
          "active": "[%key:common::state::active%]",
          "green": "[%key:component::irm_kmi::entity::sensor::pollen_alder::state::green%]",
          "none": "[%key:component::irm_kmi::entity::sensor::pollen_alder::state::none%]",
          "orange": "[%key:component::irm_kmi::entity::sensor::pollen_alder::state::orange%]",
          "purple": "[%key:component::irm_kmi::entity::sensor::pollen_alder::state::purple%]",
          "red": "[%key:component::irm_kmi::entity::sensor::pollen_alder::state::red%]",
          "yellow": "[%key:component::irm_kmi::entity::sensor::pollen_alder::state::yellow%]"
        }
      },
      "pollen_mugwort": {
        "name": "Mugwort pollen",
        "state": {
          "active": "[%key:common::state::active%]",
          "green": "[%key:component::irm_kmi::entity::sensor::pollen_alder::state::green%]",
          "none": "[%key:component::irm_kmi::entity::sensor::pollen_alder::state::none%]",
          "orange": "[%key:component::irm_kmi::entity::sensor::pollen_alder::state::orange%]",
          "purple": "[%key:component::irm_kmi::entity::sensor::pollen_alder::state::purple%]",
          "red": "[%key:component::irm_kmi::entity::sensor::pollen_alder::state::red%]",
          "yellow": "[%key:component::irm_kmi::entity::sensor::pollen_alder::state::yellow%]"
        }
      },
      "pollen_oak": {
        "name": "Oak pollen",
        "state": {
          "active": "[%key:common::state::active%]",
          "green": "[%key:component::irm_kmi::entity::sensor::pollen_alder::state::green%]",
          "none": "[%key:component::irm_kmi::entity::sensor::pollen_alder::state::none%]",
          "orange": "[%key:component::irm_kmi::entity::sensor::pollen_alder::state::orange%]",
          "purple": "[%key:component::irm_kmi::entity::sensor::pollen_alder::state::purple%]",
          "red": "[%key:component::irm_kmi::entity::sensor::pollen_alder::state::red%]",
          "yellow": "[%key:component::irm_kmi::entity::sensor::pollen_alder::state::yellow%]"
        }
      },
      "uv_index": {
        "name": "UV index"
      },
      "wind_gust_speed": {
        "name": "Wind gust speed"
      }
    }
  },
  "exceptions": {
    "api_error": {
      "message": "An error occurred while communicating with the API: {error}"
    }
  },
  "options": {
    "step": {
      "init": {
        "data": {
          "language_override": "[%key:common::config_flow::data::language%]"
        },
        "data_description": {
          "language_override": "[%key:component::irm_kmi::common::language_override_description%]"
        },
        "title": "Options"
      }
    }
  },
  "selector": {
    "language_override": {
      "options": {
        "de": "German",
        "en": "English",
        "fr": "French",
        "nl": "Dutch",
        "none": "Follow Home Assistant server language"
      }
    }
  },
  "title": "Royal Meteorological Institute of Belgium"
}
